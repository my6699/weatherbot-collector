# WeatherBot configuration — copy to `.env` and adjust.
# 前缀统一为 WEATHERBOT_。除实盘 CLOB 密钥外，所有参数都可用环境变量覆盖。

# ---------------------------------------------------------------------------
# 基础 / 资金
# ---------------------------------------------------------------------------
# 模拟账户起始余额（美元）
WEATHERBOT_BALANCE=10000
# 单笔最大下注（美元）。
# 【实盘安全建议】首次实盘先把 MAX_BET 降到 1~2，跑 2-4 周验证滑点后再逐步加注。
WEATHERBOT_MAX_BET=20
# 同一个城市/日期市场内最多同时持仓的桶数
WEATHERBOT_MAX_POSITIONS_PER_MARKET=3
# 单桶最低可买价（跳过超低价陈旧报价 / 幽灵尾票）
WEATHERBOT_MIN_ASK=0.02
# 最低 EV（美元/股）
WEATHERBOT_MIN_EV=0.1
# 最低概率优势（edge）才开仓，0.07 = 7%
WEATHERBOT_MIN_EDGE=0.07
# 买入价上限（常规策略）
WEATHERBOT_MAX_PRICE=0.45
# 是否交易 D+0 当日市场（默认 false：当日市场有实时观测信息优势，尾票 edge 是幻影）
WEATHERBOT_TRADE_D0=false
# 市场最小成交量过滤
WEATHERBOT_MIN_VOLUME=500
# 距结算的最小/最大小时数（只在这个窗口内交易）
WEATHERBOT_MIN_HOURS=2
WEATHERBOT_MAX_HOURS=72
# Kelly 比例（0.25 = 半 Kelly）
WEATHERBOT_KELLY_FRACTION=0.25
# 最大买卖价差（绝对，美元）
WEATHERBOT_MAX_SLIPPAGE=0.03

# ---------------------------------------------------------------------------
# 终局扫盘（D+0 结算前确定性套利）
# ---------------------------------------------------------------------------
# 开关
WEATHERBOT_ENDGAME_SWEEP=true
# 结算前多少小时进入终局窗口
WEATHERBOT_ENDGAME_HOURS=6
# 锁定观测落入桶时的固定置信概率（0.93 = 留 7% 观测误差容错）
WEATHERBOT_ENDGAME_LOCKED_P=0.93
# 锁定买入价区间
WEATHERBOT_ENDGAME_MIN_ASK=0.75
WEATHERBOT_ENDGAME_MAX_ASK=0.95
# 【时间陷阱防护】当地 14:00 之前不认定"最高温已锁定"（日最高温通常在 14-16 点出现）
WEATHERBOT_ENDGAME_LOCAL_HOUR_MIN=14
# METAR 较上次上升超过该值视为仍在升温 → 禁止锁定
WEATHERBOT_ENDGAME_RISING_C=0.5
WEATHERBOT_ENDGAME_RISING_F=1.0
# 未确认降温时买入上限（比 0.95 更保守，避免为可能继续冲高的"锁定峰值"付高价）
WEATHERBOT_ENDGAME_MAX_ASK_EARLY=0.88
# 当地 16:00 之后且观测开始回落 → 确认降温，才放开到 ENDGAME_MAX_ASK
WEATHERBOT_ENDGAME_COOLING_HOUR=16
# 终局未锁定时的止盈价
WEATHERBOT_ENDGAME_TAKE_PROFIT=0.90

# ---------------------------------------------------------------------------
# 卖出 / 流动性风险控制
# ---------------------------------------------------------------------------
# 卖出滑点保护：真实 bid 比预期卖出价低超过该比例时，止盈类卖出跳过（等下一轮）；
# 止损类强制成交。防止在薄盘口市价砸盘吃大滑点。
WEATHERBOT_SELL_SLIPPAGE_TOL=0.05
# 盘口深度校验：单笔下注额不得超过 YES 买盘前 2 档深度的该比例（防买得进卖不出）。
# 【实盘必开】深度不足自动降额；深度 <$0.5 跳过。
WEATHERBOT_MAX_DEPTH_FRACTION=0.3
# 【Maker 优先成交】每次买卖先挂 post-only GTC 限价单（买入挂 best bid、
# 卖出挂 best ask），不做市价吃单，不付 Maker 费、不穿点差。
# 等待 CLOB_MAKER_WAIT_MS 毫秒内未成交则撤单、降级为市价单（Taker）兜底，
# 保证订单最终成交、决策不被阻塞。止损类卖出（force）直接走市价单立即成交。
WEATHERBOT_CLOB_MAKER=true
WEATHERBOT_CLOB_MAKER_WAIT_MS=8000
WEATHERBOT_CLOB_MAKER_POLL_MS=1500
# 止损延迟确认：价格跌破止损先标记 pending，下一轮仍跌破才执行（防薄盘震仓）。
# 价格跌破该比例 × 成本（硬崩盘）则立即止损。
WEATHERBOT_STOP_HARD_MULT=0.5
# 【动态 Sigma 止损】常规止损乘数。sigma 未超过该城基础 sigma（模型分歧小、
# 确定性高）时用该紧凑值：买入价的 0.8 = 允许回撤 20%。
# 止损锚定 min(入场价, 入场时 bid)，低价桶不会被点差瞬间扫损。
WEATHERBOT_STOP_MULT=0.8
# 【动态 Sigma 止损】宽止损乘数。sigma 超过该城基础 sigma 时放宽止损。
# 【已回退 2026-08-03】回测显示：已结算止损仓 20 笔错杀率 0%（止损优于死扛，
# 死扛多亏 $162），动态放宽反而让 9 笔被"放行"后全输（多亏 $111）。
# 当前回退为与常规一致的 0.8（等同固定止损）。若未来非极端期数据积累后
# 显示存在"被噪音扫损"的盈利单，可再调小此值重新启用。
WEATHERBOT_STOP_MULT_WIDE=0.8
# 【单城市日敞口上限】同一城市同一天所有未平仓仓位的累计成本（Cost）上限（美元）。
# 超过则跳过新买入，防 London/Tokyo 这类连续开仓导致的单城黑天鹅拖垮账户。
WEATHERBOT_MAX_CITY_COST_PER_DATE=40

# ---------------------------------------------------------------------------
# 极端天气熔断（黑天鹅防护）与净 Edge 校验
# ---------------------------------------------------------------------------
# 逐市场熔断：ensemble 三模型 spread（最大偏离）超过阈值 → 该市场天气不稳，跳过买入。
# 一次扫描内触发熔断的市场数 >= WEATHERBOT_BREAKER_TRIPS → 全局暂停新买入
# WEATHERBOT_BREAKER_COOLDOWN_H 小时（只停买入，卖出/止损/结算照常），防台风/强对流连续止损。
WEATHERBOT_BREAKER_SPREAD_C=3.5
WEATHERBOT_BREAKER_SPREAD_F=6.3
WEATHERBOT_BREAKER_TRIPS=3
WEATHERBOT_BREAKER_COOLDOWN_H=24
# 净 Edge：买入时从 edge 中扣除"当前点差 × 该比例"作为预估退出滑点，
# 确保 MIN_EDGE 是净收益而非毛利（提前退出会再次穿过点差）。
WEATHERBOT_EXIT_SPREAD_FRAC=0.5

# ---------------------------------------------------------------------------
# 实盘 CLOB（默认关闭 = 模拟交易。开启后真实下单，资金风险自负！）
# ---------------------------------------------------------------------------
# 设为 true 启用真实下单（必须同时配置下方密钥）
# WEATHERBOT_CLOB_LIVE=false
# Polygon 私钥（有真实资金的地址，勿提交到仓库！）
# WEATHERBOT_POLY_PRIVATE_KEY=
# Polymarket 代理钱包地址（该地址持有 USDC）
# WEATHERBOT_POLY_PROXY_WALLET=
# 链 ID（Polygon 主网 137，Amoy 测试网 80002）
# WEATHERBOT_POLY_CHAIN_ID=137
# CLOB L2 API 凭证（可选，缺省会自动派生）
# WEATHERBOT_POLY_CLOB_API_KEY=
# WEATHERBOT_POLY_CLOB_API_SECRET=
# WEATHERBOT_POLY_CLOB_API_PASSPHRASE=

# ---------------------------------------------------------------------------
# 免费大模型（LLM 风险顾问 + 周度复盘）
# ---------------------------------------------------------------------------
# 开关（默认开；无密钥时自动跳过，不影响交易逻辑。LLM 只做建议，失败不阻塞交易）
WEATHERBOT_LLM_ENABLED=true
# 提供商：gemini（默认，免费）/ groq / deepseek / openrouter / custom
WEATHERBOT_LLM_PROVIDER=gemini
# 模型名（留空用各提供商默认免费模型，如 gemini-flash-latest）
# WEATHERBOT_LLM_MODEL=
# 【第二意见模型】可选项，与 LLM_PROVIDER 同取值（如 deepseek）。
# 配置后每次买入前让第二个 AI 独立审查，两模型一致才买：
#   - LLM_GATE=false（默认）：只记录合并意见到日志/报告，不拦截
#   - LLM_GATE=true：任一模型判 skip 即否决该笔买入（最保守）
# 任一模型失败/限流自动降级为单模型意见，不影响交易。留空 = 只用主模型。
WEATHERBOT_LLM_PROVIDER2=deepseek
# 第二模型名（留空用该提供商默认模型，如 deepseek-chat）
# WEATHERBOT_LLM_MODEL2=
# true = LLM 判定 skip 时直接拦截买入（默认 false：仅记录 [LLM] 日志供复盘）
# 【建议】先跑 2-4 周 advisory 模式确认无误杀，再开 gate
WEATHERBOT_LLM_GATE=false
# 单次扫描每模型最多调用 LLM 次数（保护免费额度，防触发限流）
WEATHERBOT_LLM_MAX_CALLS_PER_SCAN=8
# LLM 请求超时（毫秒）
WEATHERBOT_LLM_TIMEOUT_MS=30000

# Google Gemini 免费额度（15 RPM / 1500 次每日，无需信用卡）
# 申请：https://aistudio.google.com/app/apikey
# 注意：本地运行需能访问 Google API（你已配置代理会自动走系统代理）
GEMINI_API_KEY=
# Groq 免费额度（可选，https://console.groq.com，30 RPM 无需绑卡）
# GROQ_API_KEY=
# DeepSeek API（第二意见模型用，https://platform.deepseek.com，OpenAI 兼容）
# 注意：DeepSeek 是付费 API（需充值，按量计费，价格很低，每百万 token 约 ¥1-2 级）
# DEEPSEEK_API_KEY=
# OpenRouter 免费模型（可选，https://openrouter.ai）
# OPENROUTER_API_KEY=
# 自定义 OpenAI 兼容端点（可选，例如国内免费/低价端点）
# WEATHERBOT_LLM_CUSTOM_BASE=https://api.example.com/v1
# WEATHERBOT_LLM_CUSTOM_KEY=

# 每次真实买入时，自动在 data/reports/ 生成一份小白能看懂的投资建议报告
# （确定性模板 + 可选 AI 大白话解读；报告随 data/ 一起提交到仓库）
WEATHERBOT_ADVICE=true

# ---------------------------------------------------------------------------
# METAR 逐小时历史归档（结算源真值，免费）
# ---------------------------------------------------------------------------
# 用 aviationweather.gov 逐小时 METAR 计算每个机场站每天的"真实日最高温"（°C），
# 存入 data/metar_max.json。它是结算依据本身，用于：
#   (a) 结算对齐校验：Polymarket 结算值 vs METAR 日最高，差 >1° 自动报警
#   (b) 校准：用真实站点最高温（而非桶中点）计算 sigma/偏差表
# 每站每天最多拉取 1 次（每小时扫描不会重复请求）
WEATHERBOT_METAR_ARCHIVE_HOURS=192

# ---------------------------------------------------------------------------
# 预报偏差修正（城市×时距×模型 滚动偏差表，data/bias.json）
# ---------------------------------------------------------------------------
# 开关（默认关！）。偏差 = 预报 - 实际，正值表示预报偏低需上调。
# 2026-08-02 回测：仅 2 天数据时单城信号被相关性快照主导且城市方向分裂
# （Dallas/Tel Aviv/Toronto 偏高、Tokyo/Munich/Singapore 偏低），自动应用
# 反而让平均误差 1.76°→3.01°。当前只保留偏差表生成 + LLM 周度评估。
# 待每城独立已结算日 ≥5 天后再开启（需同时收紧采样：独立天数计数+末条快照+上限 1°）。
WEATHERBOT_BIAS_ENABLED=false
# 每个 (城市,时距,模型) 至少多少已结算样本才应用修正
WEATHERBOT_BIAS_MIN_N=2
# 单次修正幅度上限（°C；华氏城市自动 ×1.8）
WEATHERBOT_BIAS_MAX_C=2.0
# 样本少于该数时，修正向 0 收缩（防单笔离群值过度修正）
WEATHERBOT_BIAS_SHRINK_N=4
# 滚动窗口：每键只保留最近 N 个样本
WEATHERBOT_BIAS_FORGET_N=12

# ---------------------------------------------------------------------------
# D+0 METAR 确认买入（事件当天只用实时观测确认后才买）
# ---------------------------------------------------------------------------
# 开关（默认开）。开启后事件当天（D+0）的常规买入必须通过 METAR 确认，
# 替代原来的 TRADE_D0 全开/全关闸门：观测已接近目标桶下限且未暴跌才允许买
WEATHERBOT_METAR_CONFIRM=true
# 仅在距结算该小时内对 D+0 做确认（超出视为观测无参考意义，直接跳过 D+0）
WEATHERBOT_METAR_CONFIRM_HOURS=24
# 当地时刻早于该小时不确认（清晨观测无法预示当日最高温）
WEATHERBOT_METAR_CONFIRM_LOCAL_HOUR_MIN=11
# 观测需 ≥ 目标桶下限 - 该裕量，且相对上一条观测跌幅不超过该裕量
WEATHERBOT_METAR_CONFIRM_MARGIN_C=1.0
WEATHERBOT_METAR_CONFIRM_MARGIN_F=1.8
# 【实际偏离立即了结】持仓期间实时 METAR 明显偏离持仓桶（上破桶上沿+裕量，
# 或当地已过峰值时段仍远低于桶下限-裕量）→ 该桶必然不中，立即平仓（不拖到止损）。
# 同时新增：同一桶全程只投注一次（平仓后不再买回该桶）。
WEATHERBOT_METAR_DIVERGE_MARGIN_C=1.5
WEATHERBOT_METAR_DIVERGE_MARGIN_F=2.7

# ---------------------------------------------------------------------------
# 内部 / 高级
# ---------------------------------------------------------------------------
# 扫描间隔（秒，本地 run 模式用）
WEATHERBOT_SCAN_INTERVAL=3600
# 校准最小样本数（少于该值不自动重校准）
WEATHERBOT_CALIBRATION_MIN=30
